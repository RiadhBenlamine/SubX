# SubX Configuration File

scope:
  - google.com
  - googlecontent.app


out_of_scope:
#  - something.google.com

# Remove sources to run all plugins
sources:
  - ShodanPlugin
  - AlienVaultPlugin
  - UrlscanPlugin
  - VirustotalPlugin
  - ChaosPlugin
  - HackerTargetPlugin
  - AnubisDbPlugin
  - BevigilPlugin
  - ViewDnsPlugin
  - BgpPlugin
  - CrtshPlugin

api_keys:
  SHODAN_API: <api>
  VIRUSTOTAL_API: <api>
  OTX_API: <api>
  URLSCAN_API: <api>
  CHAOS_API: <api>
  BEVIGIL_API: <api>
  VIEWDNS_API: <api>

# PostgreSQL Database Configuration (Main Database)
db:
  host: "127.0.0.1"
  user: "postgres"
  password: ""
  port: 5432
  dbname: "subx"

# Tool parameters — each key becomes a CLI flag (e.g. threads: 50 → -threads 50)
# tools:
#   dnsx:
#     threads: 100
#   httpx:
#     threads: 50
#     rate-limit: 150
#     timeout: 10
